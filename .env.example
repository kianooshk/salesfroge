# ---- Database ----
POSTGRES_USER=salesfroge
POSTGRES_PASSWORD=salesfroge
POSTGRES_DB=salesfroge
# Used by the backend (inside docker-compose the host is "db")
DATABASE_URL=postgresql://salesfroge:salesfroge@localhost:5432/salesfroge?schema=public

# ---- Backend ----
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Public URL of the frontend (used for CORS + OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ---- Google OAuth (sign-in + calendar sync) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:4000/api/calendar/google/callback

# ---- Microsoft / Outlook OAuth (calendar sync) ----
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_CALLBACK_URL=http://localhost:4000/api/calendar/outlook/callback

# ---- Email (SMTP outbound) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Salesfroge <no-reply@salesfroge.local>"

# ---- Email (IMAP inbound logging) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# ---- Files ----
UPLOAD_DIR=./uploads

# ---- Frontend ----
# Base URL the browser uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api
